# Health Vitals — Production Environment Contract (Split Managed Stack)
# Copy to `.env.production` (gitignored) and populate real credentials before running `./infra/fly/deploy.sh`.
# Schema validated at runtime by `packages/platform/src/config/env.ts`.

# --- Runtime ---
NODE_ENV=production
PORT=3000

# --- Neon PostgreSQL (https://neon.tech) ---
# Pooled or direct SSL connection string from `neonctl connection-string`
DATABASE_URL=postgres://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require

# --- Neon Object Storage (declared in neon.ts) ---
# S3-compatible credentials from the Neon branch Object Storage settings
STORAGE_ENDPOINT=https://<neon-storage-endpoint>
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=<neon-storage-access-key>
STORAGE_SECRET_KEY=<neon-storage-secret-key>
STORAGE_BUCKET=health-vitals-uploads

# --- CloudAMQP / RabbitMQ (https://www.cloudamqp.com) ---
# Durable queue asserted at runtime: `file_processing`
RABBITMQ_URL=amqps://<user>:<password>@<host>.rmq.cloudamqp.com/<vhost>

# --- Fly.io API & Auth (infra/fly/api.toml) ---
# Frontend origin used for verification & password-reset links and CORS
WEB_URL=https://binderlex.com
SECRET_JWT_KEY=<generate-strong-256-bit-random-secret>

# --- Resend Email Delivery (https://resend.com) ---
# Requires verified sending domain (`binderlex.com`) in Cloudflare DNS (see infra/dns/README.md)
MAIL_PROVIDER=resend
MAIL_FROM="HealthVitals <noreply@binderlex.com>"
RESEND_API_KEY=re_<resend-api-key>

# --- Google Gemini AI Studio (infra/fly/worker.toml) ---
# Supported models & quotas defined in `packages/contracts/src/llm.ts`
LLM_PROVIDER=google
GEMINI_API_KEY=<google-ai-studio-api-key>
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Vercel Frontend (apps/web, configured in Vercel Project Environment Variables) ---
# Not injected into Fly.io containers; set directly in Vercel for Production/Preview
VITE_API_URL=https://api.binderlex.com
