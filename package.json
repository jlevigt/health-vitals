{
  "name": "health-data-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --env-file=.env --cwd packages/api dev",
    "dev:web": "bun run --cwd packages/web dev",
    "dev:mock": "bun run --cwd packages/web dev:mock",
    "dev:worker": "bun run --env-file=.env --cwd packages/worker dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "migration:run": "bun run --env-file=.env packages/shared/src/db/scripts/migrate.ts",
    "migration:create": "bun run --env-file=.env packages/shared/src/db/scripts/migration-create.ts"
  }
}