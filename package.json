{
  "name": "health-vitals",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --env-file=.env apps/api/src/server.ts",
    "dev:worker": "bun --env-file=.env apps/worker/src/worker.ts",
    "dev:web": "bun run --cwd ./apps/web dev",
    "dev:mock": "bun run --cwd ./apps/web dev:mock",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "migration:run": "bun --env-file=.env apps/migrator/src/index.ts",
    "migration:create": "bun --env-file=.env packages/ops/scripts/migration-create.ts",
    "init:s3": "bun --env-file=.env packages/ops/scripts/init.ts"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.8",
    "@types/pg": "8.20.0"
  }
}