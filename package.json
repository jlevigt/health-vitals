{
  "name": "health-vitals",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "migration:run": "bun --env-file=.env apps/migrator/src/index.ts",
    "migration:create": "./scripts/migration-create.sh",
    "lint": "echo 'No linting configured yet'",
    "typecheck": "bun run --filter '*' build",
    "build": "bun run --filter '*' build",
    "test": "bun test --env-file=.env apps/*/src packages/*/src"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  }
}
