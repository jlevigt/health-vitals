{
  "name": "health-data-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd packages/api dev",
    "dev:worker": "bun run --cwd packages/worker dev",
    "dev:web": "bun run --cwd packages/web dev",
    "dev:mock": "bun run --cwd packages/web dev:mock",
    "infra:up": "docker compose -f infra/docker/docker-compose.local.yml up -d postgres_dev rabbitmq minio",
    "infra:down": "docker compose -f infra/docker/docker-compose.local.yml down",
    "migration:run": "bun --env-file=.env.local run packages/shared/src/db/scripts/migrate.ts",
    "migration:create": "bun --env-file=.env.local run packages/shared/src/db/scripts/migration-create.ts"
  }
}