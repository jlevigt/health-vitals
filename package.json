{
  "name": "health-data-app",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun run --env-file=.env --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:mock": "bun run --cwd apps/web dev:mock",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "migration:run": "bun run --env-file=.env infra/scripts/migrate.js",
    "migration:create": "bun run --env-file=.env infra/scripts/migration-create.js"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}