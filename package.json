{
  "name": "health-vitals",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/jobs/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "migration:run": "bun --env-file=.env apps/jobs/migrator/src/index.ts",
    "migration:create": "./scripts/migration-create.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' build",
    "build": "bun run --filter '*' build",
    "test": "bun test --env-file=.env tests apps/*/tests apps/jobs/*/tests packages/*/tests apps/*/src apps/jobs/*/src packages/*/src"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "^1.3.13"
  }
}
