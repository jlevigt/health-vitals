{
  "name": "health-vitals",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --env-file=.env --watch apps/api/src/server.ts",
    "dev:worker": "bun --env-file=.env --watch apps/worker/src/worker.ts",
    "dev:web": "bun run --filter @health-vitals/web dev",
    "dev:mock": "bun run --filter @health-vitals/web dev:mock",
    "dev": "bun run infra:up && sleep 5 && (bun run dev:api & bun run dev:worker & bun run dev:web)",
    "infra:up": "docker compose --env-file .env -f infra/local/compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/local/compose.yml down",
    "migration:run": "bun --env-file=.env apps/migrator/src/index.ts",
    "migration:create": "./scripts/migration-create.sh",
    "lint": "echo 'No linting configured yet'",
    "typecheck": "bun run --filter '*' build",
    "build": "bun run --filter '*' build",
    "test": "bun test --env-file=.env apps/*/src packages/*/src"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  }
}
