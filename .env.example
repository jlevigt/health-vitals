# Server Config
PORT=3000
NODE_ENV=development

# Database
# CHANGED: 'localhost' -> 'postgres'
DATABASE_URL=postgres://local_user:local_password@postgres:5432/dev

# CHANGED: 'localhost' -> 'postgres'
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_PASSWORD=local_password
POSTGRES_DB=dev

# Security
SECRET_JWT_KEY=your_super_secret_jwt_key_change_me

# AI Provider
GEMINI_API_KEY=

# Mail
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_PROVIDER=
RESEND_API_KEY=

# Storage
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Docker-specific overrides (for images that expect these exact names)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_CORS_ALLOW_ORIGIN="*"
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
