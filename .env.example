# Server Config
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/health_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=health_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Security
SECRET_JWT_KEY=your_super_secret_jwt_key_change_me

# AI Provider (Optional - falls back to Mock if empty)
GEMINI_API_KEY=

# Mail (Optional - defaults to Ethereal for dev)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=

# Storage (Minio for dev, R2 for prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
