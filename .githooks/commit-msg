#!/bin/bash

# Simple regex for conventional commits
# type(scope): subject
# type: subject
COMMIT_MSG_REGEX="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?!?: .+"

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

if [[ ! $COMMIT_MSG =~ $COMMIT_MSG_REGEX ]]; then
    echo -e "\e[31mError: Invalid commit message format.\e[0m"
    echo -e "Commit messages must follow the Conventional Commits specification:"
    echo -e "  type(optional-scope): description"
    echo -e "Example: feat(auth): add login endpoint"
    echo -e "Allowed types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
    exit 1
fi
